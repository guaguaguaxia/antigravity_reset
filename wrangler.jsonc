{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antigravity-reset",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "ANTIGRAVITY_KV",
      "id": "5619d55fc1c649879691954f662c7394"
    }
  ],
  "routes": [
    { "pattern": "antigravityreset.app", "custom_domain": true },
    { "pattern": "www.antigravityreset.app", "custom_domain": true }
  ]
}
